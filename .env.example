# SpacetimeDB (Phase 2+)
VITE_SPACETIMEDB_URI=ws://localhost:3000
VITE_SPACETIMEDB_MODULE=better-baltimore

# Optional: Civic Copilot generation (Phase 6). If unset, the app falls back
# to showing retrieved evidence chunks directly with no LLM generation.
# NOTE: this is bundled into the client JS (Vite VITE_ prefix) — fine for a
# hackathon demo with a restricted/throwaway key, not for production without
# a backend proxy.
VITE_GEMINI_API_KEY=
